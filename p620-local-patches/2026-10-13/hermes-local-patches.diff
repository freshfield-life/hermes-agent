     return notify_metadata
 
 
+# Raven-conditional (candidate Freshfield Raven adapter contract): the metadata key the
+# reviewed Raven adapter records on its admitted event (``_build_event``) and re-requires
+# on the final send. Read here only; never written for any other platform.
+RAVEN_SOURCE_REVISION_METADATA_KEY = "raven_source_revision"
+
+
+def _raven_source_metadata_for_event(event) -> dict | None:
+    """The admitted Raven turn's server-owned source identity for the final send, or None.
+
+    The reviewed Raven adapter binds its ONE per-turn reply capability to the admitted
+    event object and refuses every final send whose metadata does not explicitly carry
+    the matching ``source_message_id`` / ``source_revision`` / ``source_requester``
+    triple. The values are read off the SAME event the Raven adapter built from the
+    trusted resolver when it admitted the message: ``event.message_id`` (the admitted
+    message id), ``source.user_id`` (the verified requester) and the
+    ``raven_source_revision`` event metadata the adapter recorded.
+
+    Strictly Raven-scoped and fail-closed: any other platform — or a Raven event
+    missing any field — returns ``None``, so the send metadata stays byte-identical
+    to the previous behaviour on every other platform.
+    """
+    source = getattr(event, "source", None)
+    if _platform_name(getattr(source, "platform", None)) != "raven":
+        return None
+    metadata = getattr(event, "metadata", None)
+    revision = metadata.get(RAVEN_SOURCE_REVISION_METADATA_KEY) if isinstance(metadata, dict) else None
+    message_id = getattr(event, "message_id", None)
+    requester = getattr(source, "user_id", None)
+    # Relay verbatim, but only real values: a blank/missing/non-string field adds
+    # nothing so the send stays exactly as fail-closed as before.
+    if not (isinstance(message_id, str) and message_id.strip()):
+        return None
+    if not (isinstance(revision, str) and revision.strip()):
+        return None
+    if not (isinstance(requester, str) and requester.strip()):
+        return None
+    return {
+        "source_message_id": message_id,
+        "source_revision": revision,
+        "source_requester": requester,
+    }
+
+
